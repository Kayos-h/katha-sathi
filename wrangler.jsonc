{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kathasathi",
  "main": "src/index.js",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "kathasathi.hlenterprises.com.np",
      "custom_domain": true
    }
  ]
}
